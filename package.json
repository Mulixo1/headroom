{
  "name": "headroom",
  "version": "0.1.2",
  "private": true,
  "description": "Local macOS menubar and localhost dashboard for remaining GPT, Grok, and Cursor usage (MIT-licensed).",
  "type": "module",
  "bin": {
    "headroom": "./bin/headroom.mjs"
  },
  "scripts": {
    "start": "node bin/headroom.mjs start",
    "dev": "node --watch bin/headroom.mjs start",
    "panel": "node bin/headroom.mjs open",
    "sync-swiftbar": "node bin/headroom.mjs sync-swiftbar",
    "quota": "node bin/headroom.mjs quota",
    "setup": "node scripts/install.mjs --no-start",
    "install:local": "node scripts/install.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "service:install": "node bin/headroom.mjs service install",
    "service:status": "node bin/headroom.mjs service status",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "service:repair": "node bin/headroom.mjs service repair",
    "ci": "npm test && node bin/headroom.mjs help"
  },
  "files": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "bin/",
    "config.example.json",
    "docs/",
    "docs/LEGAL.md",
    "scripts/",
    "src/"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "swiftbar",
    "menubar",
    "openai",
    "chatgpt",
    "codex",
    "xai",
    "grok",
    "quota",
    "usage",
    "headroom",
    "macos",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mulixo1/headroom.git"
  },
  "bugs": {
    "url": "https://github.com/Mulixo1/headroom/issues"
  },
  "homepage": "https://github.com/Mulixo1/headroom#readme",
  "author": {
    "name": "Mulixo",
    "url": "https://github.com/Mulixo1"
  }
}
